# Server
NODE_ENV=production
PORT=10000

# Frontend URL (required for CORS and cookies)
# Use your deployed Render frontend URL, e.g. https://mealbridge.onrender.com
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mealbridge?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# File uploads (optional)
UPLOAD_FOLDER=uploads
